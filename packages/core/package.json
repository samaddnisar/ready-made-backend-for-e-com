{
  "name": "@repo/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/client.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./errors": "./src/errors.ts",
    "./flags": "./src/features/flags.ts",
    "./rbac": "./src/rbac/index.ts",
    "./settings": "./src/settings/service.ts",
    "./validation": "./src/validation/index.ts"
  },
  "scripts": {
