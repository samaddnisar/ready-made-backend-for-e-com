{
  "name": "ecommerce-boilerplate",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @repo/core db:generate",
    "db:migrate": "pnpm --filter @repo/core db:migrate",
    "db:seed": "pnpm --filter @repo/core db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
